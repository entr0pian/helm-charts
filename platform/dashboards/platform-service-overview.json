      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{component=\"$component\", environment=\"$environment\"}[$__rate_interval]))) >= 0",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ]
    },
