          "legendFormat": "{{pod}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "Go Heap vs Process RSS",
      "description": "What the Go process itself holds, per replica: heap in use (live objects plus fragmentation) and process RSS (everything resident, including memory the runtime has freed but not yet returned). Container memory above is the cgroup's view and is what the limit applies to.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": ""
          },
          "min": 0,
          "noValue": "No Go runtime metrics"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (go_memstats_heap_inuse_bytes{component=\"$component\", environment=\"$environment\"})",
          "legendFormat": "heap in use {{pod}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (process_resident_memory_bytes{component=\"$component\", environment=\"$environment\"})",
          "legendFormat": "process RSS {{pod}}",
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "DB Connection Pool",
      "description": "database/sql pool state per database binding, across all replicas. Max open is only drawn when the pool has a cap.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "connections"
          },
          "min": 0,
          "noValue": "No database",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* max open"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (db_name) (go_sql_in_use_connections{component=\"$component\", environment=\"$environment\"})",
          "legendFormat": "{{db_name}} in use",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (db_name) (go_sql_idle_connections{component=\"$component\", environment=\"$environment\"})",
          "legendFormat": "{{db_name}} idle",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (db_name) (go_sql_open_connections{component=\"$component\", environment=\"$environment\"})",
          "legendFormat": "{{db_name}} open",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (db_name) (go_sql_max_open_connections{component=\"$component\", environment=\"$environment\"}) > 0",
          "legendFormat": "{{db_name}} max open",
          "refId": "D",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "DB Connection Waits",
      "description": "Requests that had to wait for a free pool connection (left axis) and the time spent blocked per second (right axis). Anything above zero means the pool is the bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "waits/s"
          },
          "min": 0,
          "noValue": "No database"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* blocked"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "blocked s/s"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (db_name) (rate(go_sql_wait_count_total{component=\"$component\", environment=\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{db_name}} waits/s",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (db_name) (rate(go_sql_wait_duration_seconds_total{component=\"$component\", environment=\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{db_name}} blocked",
          "refId": "B",
          "range": true
        }
      ]
    }
  ]
